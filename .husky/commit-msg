# .husky/commit-msg
if ! bun ./node_modules/@commitlint/cli/cli.js --edit "$1"; then
    echo ""
    echo "  Formato requerido: tipo: descripción"
    echo "  Ejemplos válidos:"
    echo "    feature: agregar pantalla de login"
    echo "    fix: corregir error en hook useWallets"
    echo "    ui: mejorar empty state de billeteras"
    echo ""
    echo "  Tipos permitidos: feat, fix, ui, refactor, chore, docs, test, perf, revert, hotfix"
    exit 1
fi
